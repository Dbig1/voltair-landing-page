import os
from heygen_pipeline import create_scene_video

def export_all(scenes, output_dir="data/output/videos"):
    os.makedirs(output_dir, exist_ok=True)
    for i, s in enumerate(scenes):
        result = create_scene_video(s["images"], s["instructions"])
        video_url = result.get("video_url")
        # Download or save link
        print(f"Scene {i} video URL:", video_url)

